DISCORD_TOKEN=
DISCORD_GUILD_ID=
TIMEZONE=America/New_York

# Per-job channels. Each effector names the variable it reads; see catalog.json.
QUEST_BOARD_CHANNEL_ID=

# Alternative to the per-job vars above: one JSON object of ENV_NAME to channel
# id. This is what GitHub Actions uses, so adding an effector needs no new
# secret. Explicit vars win over this blob.
# EFFECTOR_CHANNELS={"QUEST_BOARD_CHANNEL_ID":"123456789"}

# Durable state. Only set locally if you want a local run to share the real
# dedup history; without it a local run keeps state in memory.
# GITHUB_TOKEN=
# BOT_STATE_ISSUE_NUMBER=
